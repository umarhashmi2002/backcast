# -----------------------------------------------------------------------------
# Retrace environment configuration (copy to .env for local development)
# -----------------------------------------------------------------------------

# CockroachDB connection (Cloud Serverless or local docker-compose).
# Local:  postgresql://root@localhost:26257/retrace?sslmode=disable
# Cloud:  postgresql://<user>:<pass>@<host>:26257/retrace?sslmode=verify-full
RETRACE_DATABASE_URL=postgresql://root@localhost:26257/retrace?sslmode=disable

# AWS / Bedrock
AWS_REGION=us-east-1
# Foundation model used for the agent's reasoning (Anthropic Claude on Bedrock).
# Reasoning model (Claude on Bedrock; needs Anthropic use-case access enabled).
# Until then, an Amazon Nova model works out of the box, e.g. us.amazon.nova-pro-v1:0
RETRACE_BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5
# Embedding model used to vectorize memories (Amazon Titan Text Embeddings v2 -> 1024 dims).
RETRACE_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
RETRACE_EMBEDDING_DIMS=1024

# S3 bucket for raw incident artifacts (logs, traces, screenshots).
RETRACE_ARTIFACT_BUCKET=

# Memory consolidation / decay tuning
RETRACE_CONSOLIDATION_LOOKBACK_HOURS=24
RETRACE_MEMORY_DECAY_HALFLIFE_DAYS=30
RETRACE_RECALL_TOP_K=8

# Observability
RETRACE_LOG_LEVEL=INFO
RETRACE_ENV=local
