# -----------------------------------------------------------------------------
# Backcast environment configuration (copy to .env for local development)
# -----------------------------------------------------------------------------

# CockroachDB connection (Cloud Serverless or local docker-compose).
# Local:  postgresql://root@localhost:26257/backcast?sslmode=disable
# Cloud:  postgresql://<user>:<pass>@<host>:26257/backcast?sslmode=verify-full
BACKCAST_DATABASE_URL=postgresql://root@localhost:26257/backcast?sslmode=disable

# AWS / Bedrock
AWS_REGION=us-east-1
# Foundation model used for the agent's reasoning (Anthropic Claude on Bedrock).
# Reasoning model (Claude on Bedrock; needs Anthropic use-case access enabled).
# Until then, an Amazon Nova model works out of the box, e.g. us.amazon.nova-pro-v1:0
BACKCAST_BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5
# Embedding model used to vectorize memories (Amazon Titan Text Embeddings v2 -> 1024 dims).
BACKCAST_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BACKCAST_EMBEDDING_DIMS=1024

# S3 bucket for raw incident artifacts (logs, traces, screenshots).
BACKCAST_ARTIFACT_BUCKET=

# Memory consolidation / decay tuning
BACKCAST_CONSOLIDATION_LOOKBACK_HOURS=24
BACKCAST_MEMORY_DECAY_HALFLIFE_DAYS=30
BACKCAST_RECALL_TOP_K=8

# Observability
BACKCAST_LOG_LEVEL=INFO
BACKCAST_ENV=local
